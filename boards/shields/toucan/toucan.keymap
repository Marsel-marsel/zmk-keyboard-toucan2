#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE   0
#define SYM    1
#define NAV    2
#define NUMPAD 3
#define FKEYS  4
#define MEDIA  5
#define MOU    6

/ {
    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>;
            hold-trigger-on-release;
        };

        tmux_prefix: tmux_prefix {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp SPACE>;
        };

        tmux_fkeys: tmux_fkeys {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tmux_prefix>;
        };

    };

    combos {
        compatible = "zmk,combos";
        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&studio_unlock>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp ESC   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
                &kp TAB   &hml LGUI A &hml LALT S &hml LSHFT D &hml LCTRL F &kp G   &kp H &hmr RCTRL J &hmr RSHFT K &hmr RALT L &hmr RGUI SEMI &kp SQT
                &kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp RSHFT
                                &lt NAV RET &mo NUMPAD &none   &tmux_fkeys FKEYS 0 &mo MEDIA &lt SYM SPACE
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &trans &none &none &kp LBKT &kp RBKT &kp GRAVE   &none &kp LS(N7) &kp LS(N8) &kp LS(N9) &kp LS(N0) &trans
                &none  &kp LGUI &kp BSLH &kp LS(LBKT) &kp LS(RBKT) &kp LS(BSLH)   &none &kp LS(N4) &kp LS(N5) &kp LS(N6) &kp BSLH &none
                &none  &none &none &kp LS(N9) &kp LS(N0) &kp LS(GRAVE)   &none &kp LS(N1) &kp LS(N2) &kp LS(N3) &kp LS(MINUS) &none
                                &kp SPACE &none &none   &none &none &none
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &trans &none &none &none &none &none   &kp HOME &kp PG_DN &kp PG_UP &kp END &kp DEL &kp BSPC
                &none  &kp LGUI &kp LALT &kp LSHFT &kp LCTRL &none   &kp LEFT &kp DOWN &kp UP &kp RIGHT &none &none
                &none  &none &none &none &none &none   &none &none &none &none &none &none
                                &none &none &none   &none &none &kp DEL
            >;
        };

        numpad {
            display-name = "NUM";
            bindings = <
                &trans &none &none &none &none &none   &kp KP_PLUS &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp DEL &trans
                &none  &kp LGUI &kp LALT &kp LSHFT &kp LCTRL &none   &kp KP_MINUS &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp LS(LBKT) &kp LS(RBKT)
                &none  &none &none &none &none &none   &kp KP_EQUAL &kp KP_N1 &kp KP_N2 &kp KP_N3 &none &none
                                &none &none &none   &none &kp KP_DOT &kp KP_N0
            >;
        };

        fkeys {
            display-name = "FKEYS";
            bindings = <
                &trans &none &none &none &none &none   &none &kp F7 &kp F8 &kp F9 &kp F12 &none
                &none  &kp LGUI &kp LALT &kp LSHFT &kp LCTRL &none   &none &kp F4 &kp F5 &kp F6 &kp F11 &none
                &none  &none &none &none &none &none   &none &kp F1 &kp F2 &kp F3 &kp F10 &none
                                &none &none &none   &none &none &kp LA(F4)
            >;
        };

        media {
            display-name = "MEDIA";
            bindings = <
                &trans &none &none &none &none &none   &none &none &none &none &kp PSCRN &none
                &studio_unlock &kp C_MUTE &kp C_VOL_UP &kp C_VOL_DN &kp PSCRN &none   &none &kp C_VOL_DN &kp C_VOL_UP &none &none &none
                &none  &none &kp LC(C) &kp LC(V) &none &none   &none &kp C_MUTE &none &none &none &none
                                &none &none &none   &none &none &none
            >;
        };

        mou {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans   &trans &trans &trans &trans &trans &trans
                                &mkp MCLK &mkp LCLK &mkp RCLK   &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };
    };
};
